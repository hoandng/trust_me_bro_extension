GEMINI_API_KEY=
TAVILY_API_KEY=
FACTCHECK_API_KEY=
# 1–2 queries per search provider. Each may make one fallback request.
SEARCH_QUERY_LIMIT=2
ANALYSIS_TIMEOUT_SECONDS=25

# Chỉ bật khi biết IP/CIDR của tất cả proxy tin cậy.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_NETWORKS=[]
EXTENSION_API_KEY=my_secret_key
# Dùng một khóa khác với EXTENSION_API_KEY cho endpoint thống kê.
ADMIN_API_KEY=
# Giá ước tính bằng USD, theo model và theo gói Tavily thực tế.
GEMINI_TOKEN_PRICES={}
# TAVILY_USD_PER_CREDIT=
ALLOWED_ORIGINS=chrome-extension://my_extension_id

# Ordered fallback ring; configure models enabled for your project.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODELS=["gemini-3.1-flash-lite","gemini-3.5-flash","gemini-2.5-flash-lite"]
GEMINI_QUOTA_COOLDOWN_SECONDS=60
